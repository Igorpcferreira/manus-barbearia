---
import { Image } from 'astro:assets';
import aboutImg from '@/assets/images/about.jpg';
import SectionHead from '@/components/SectionHead.astro';
import Counter from '@/components/islands/Counter.tsx';
import { stats } from '@/data/site';
---

<section
  id="sobre"
  class="relative z-10 mx-auto max-w-[1160px] scroll-mt-24 px-4 py-20 sm:px-6 sm:py-28"
>
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <SectionHead kicker="Sobre Nós">
        Mais que um corte, uma <span class="text-gradient">experiência</span>
      </SectionHead>

      <div class="reveal mt-6 space-y-4 text-bone-2" style="--reveal-delay:80ms">
        <p>
          A <strong class="text-bone">Manu's Barbearia</strong> nasceu da paixão pelo
          ofício e hoje é referência em Goiânia. São mais de 9 anos cuidando do
          visual masculino com técnica, atenção aos detalhes e aquele acabamento que
          faz diferença.
        </p>
        <p>
          Ambiente confortável, profissionais especializados e atendimento com hora
          marcada pra você não perder tempo na fila. Chegou, sentou, é atendido — do
          degradê clássico ao corte mais moderno.
        </p>
      </div>

      <div class="reveal mt-8 grid grid-cols-3 gap-3 sm:gap-4" style="--reveal-delay:160ms">
        {
          stats.map((s) => (
            <div class="rounded-xl border border-line bg-panel/40 p-4 text-center">
              <div class="font-display text-2xl font-bold text-neon sm:text-3xl">
                {"value" in s ? (
                  <Counter
                    client:visible
                    to={s.value}
                    prefix={s.prefix}
                    suffix={s.suffix}
                  />
                ) : (
                  s.text
                )}
              </div>
              <div class="mt-1 text-[11px] leading-tight text-bone-2 sm:text-xs">
                {s.label}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal" style="--reveal-delay:120ms">
      <div
        data-tilt
        class="relative overflow-hidden rounded-2xl border border-line shadow-glow-sm"
      >
        <Image
          src={aboutImg}
          alt="Ambiente da Manu's Barbearia"
          width={760}
          class="aspect-[4/3] h-full w-full object-cover transition-transform duration-700 hover:scale-105"
        />
        <span class="glare"></span>
      </div>
    </div>
  </div>
</section>
