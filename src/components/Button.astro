---
import { buttonVariants, type ButtonVariants } from '@/lib/button-variants';
import { cn } from '@/lib/utils';

interface Props extends ButtonVariants {
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
  [key: string]: unknown;
}

const { variant, size, href, class: className, ...rest } = Astro.props;
const cls = cn(buttonVariants({ variant, size }), className);
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button class={cls} {...rest}>
      <slot />
    </button>
  )
}
