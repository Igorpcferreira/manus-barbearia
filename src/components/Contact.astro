---
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import { contact, links, site } from '@/data/site';
import { MapPin, Clock, Phone, Calendar, Navigation } from 'lucide-react';
import { WhatsAppIcon } from '@/components/icons';
---

<section
  id="contato"
  class="relative z-10 mx-auto max-w-[1160px] scroll-mt-24 px-4 py-20 sm:px-6 sm:py-28"
>
  <SectionHead kicker="Onde Estamos">
    Localização & <span class="text-gradient">Contato</span>
  </SectionHead>

  <div class="mt-10 grid gap-6 lg:grid-cols-2">
    <div class="reveal relative min-h-[340px] overflow-hidden rounded-2xl border border-line shadow-glow-sm">
      <!-- Placeholder enquanto o mapa carrega: evita o "quadrado vazio".
           Some suavemente quando o iframe dispara o evento `load`. -->
      <div
        id="map-skeleton"
        class="map-skeleton absolute inset-0 z-10 grid place-items-center bg-panel/60 transition-opacity duration-500"
      >
        <div class="flex flex-col items-center gap-2.5">
          <MapPin className="size-7 animate-pulse text-neon" />
          <span class="text-[11px] font-display uppercase tracking-[0.22em] text-ash">
            Carregando mapa…
          </span>
        </div>
      </div>
      <iframe
        id="map-frame"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Mapa - Manu's Barbearia"
        src={links.mapEmbed}
        class="relative z-0 h-full min-h-[340px] w-full opacity-0 transition-opacity duration-700"
      ></iframe>
    </div>

    <div class="reveal flex flex-col gap-4" style="--reveal-delay:80ms">
      <div class="flex items-start gap-4 rounded-2xl border border-line bg-panel/40 p-5">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-void text-neon">
          <MapPin className="size-5" />
        </span>
        <div>
          <h4 class="font-display font-semibold text-bone">Endereço</h4>
          <p class="mt-1 text-sm text-bone-2">
            {contact.addressLine1}<br />
            <span class="text-ash">{contact.addressLine2}</span>
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4 rounded-2xl border border-line bg-panel/40 p-5">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-void text-neon">
          <Clock className="size-5" />
        </span>
        <div>
          <h4 class="font-display font-semibold text-bone">Horários</h4>
          <p class="mt-1 text-sm text-bone-2">
            {
              contact.hours.map((h) => (
                <span class={h.muted ? 'text-ash' : ''}>
                  {h.d} · {h.h}
                  <br />
                </span>
              ))
            }
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4 rounded-2xl border border-line bg-panel/40 p-5">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl border border-line bg-void text-neon">
          <Phone className="size-5" />
        </span>
        <div>
          <h4 class="font-display font-semibold text-bone">Telefone / WhatsApp</h4>
          <p class="mt-1 text-sm text-bone-2">{site.phone}</p>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <Button href={links.booksy} target="_blank" rel="noopener" size="sm" class="cta-attract min-h-11" data-mag>
          <Calendar /> Agendar
        </Button>
        <Button href={links.whatsapp} target="_blank" rel="noopener" variant="ghost" size="sm" class="min-h-11">
          <WhatsAppIcon /> WhatsApp
        </Button>
        <Button href={links.tel} variant="ghost" size="sm" class="min-h-11">
          <Phone /> Ligar
        </Button>
        <Button href={links.directions} target="_blank" rel="noopener" variant="ghost" size="sm" class="min-h-11">
          <Navigation /> Como chegar
        </Button>
      </div>
    </div>
  </div>
</section>

<script>
  // Revela o mapa só quando o iframe termina de carregar (evento `load` dispara
  // mesmo em iframe cross-origin), trocando o placeholder pelo mapa sem o
  // "quadrado vazio". Fallback por tempo cobre casos raros (cache/lazy).
  const frame = document.getElementById('map-frame');
  const skeleton = document.getElementById('map-skeleton');
  if (frame) {
    let revealed = false;
    const reveal = () => {
      if (revealed) return;
      revealed = true;
      frame.style.opacity = '1';
      if (skeleton) {
        skeleton.style.opacity = '0';
        setTimeout(() => skeleton.remove(), 600);
      }
    };
    frame.addEventListener('load', reveal);
    setTimeout(reveal, 6000);
  }
</script>
