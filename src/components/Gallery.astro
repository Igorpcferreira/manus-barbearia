---
import { getImage } from 'astro:assets';
import SectionHead from '@/components/SectionHead.astro';
import Lightbox, { type GalleryItem } from '@/components/islands/Lightbox.tsx';
import { galleryAlts, galleryCaptions } from '@/data/site';

import g1 from '@/assets/images/gallery-1.jpg';
import g2 from '@/assets/images/gallery-2.jpg';
import g3 from '@/assets/images/gallery-3.jpg';
import g4 from '@/assets/images/gallery-4.jpg';
import g5 from '@/assets/images/gallery-5.jpg';
import g6 from '@/assets/images/gallery-6.jpg';

const sources = [g1, g2, g3, g4, g5, g6];

const items: GalleryItem[] = await Promise.all(
  sources.map(async (src, i) => {
    const thumb = await getImage({ src, width: 640, format: 'webp', quality: 72 });
    const full = await getImage({ src, width: 1280, format: 'webp', quality: 80 });
    return {
      thumb: thumb.src,
      full: full.src,
      alt: galleryAlts[i],
      caption: galleryCaptions[i],
    };
  })
);
---

<section
  id="galeria"
  class="relative z-10 mx-auto max-w-[1160px] scroll-mt-24 px-4 py-20 sm:px-6 sm:py-28"
>
  <SectionHead kicker="O Ambiente & Resultados">
    Dá uma <span class="text-gradient">olhada</span>
  </SectionHead>

  <Lightbox client:visible items={items} />
</section>
