---
import SectionHead from '@/components/SectionHead.astro';
import Button from '@/components/Button.astro';
import { plans } from '@/data/site';
import { Check } from 'lucide-react';
---

<section
  id="planos"
  class="relative z-10 mx-auto max-w-[1160px] scroll-mt-24 px-4 py-20 sm:px-6 sm:py-28"
>
  <SectionHead kicker="Assinatura" center class="mx-auto">
    Nossos <span class="text-gradient">Planos</span>
  </SectionHead>
  <p class="reveal mx-auto mt-4 max-w-[560px] text-center text-bone-2" style="--reveal-delay:60ms">
    Do plano semanal (segunda a quarta) ao ilimitado — hora marcada, sem fila e o
    visual sempre afiado.
  </p>

  <div class="mx-auto mt-12 grid max-w-3xl gap-6 sm:grid-cols-2">
    {
      plans.map((p, i) => {
        const warm = p.featured || p.kind === 'smart';
        return (
          <div
            data-tilt
            class:list={[
              'reveal relative flex flex-col rounded-2xl border p-7 transition-all duration-300',
              p.featured
                ? 'border-gold/60 bg-gradient-to-b from-panel-2 to-panel shadow-glow-gold'
                : p.kind === 'smart'
                  ? 'border-line bg-gradient-to-b from-panel-2/60 to-panel/40 hover:border-gold/40 hover:shadow-glow-sm'
                  : 'border-line bg-panel/40 hover:border-neon/50 hover:shadow-glow-sm',
            ]}
            style={`--reveal-delay:${i * 90}ms`}
          >
            {p.featured && p.badge && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-amber to-gold px-4 py-1 text-[11px] font-display font-bold uppercase tracking-wider text-void shadow-glow-gold">
                {p.badge}
              </span>
            )}
            <div class="text-xs font-display font-semibold uppercase tracking-[0.18em] text-amber">
              {p.name}
            </div>
            <h3 class="mt-2 font-display text-xl font-bold text-bone">{p.title}</h3>

            {p.kind === 'smart' ? (
              <>
                <p class="mt-3 text-sm text-bone-2">{p.lead}</p>
                <div class="mt-2 flex flex-wrap items-end gap-x-2">
                  <span class="mb-2 font-display text-base font-semibold text-bone-2">R$</span>
                  <span class="text-gradient font-display text-6xl font-bold leading-[0.85]">
                    {p.unitPrice}
                  </span>
                  <span class="mb-1.5 font-display text-base text-bone-2">,{p.unitCents}</span>
                  <span class="mb-2 text-xs text-bone-2">{p.unitLabel}</span>
                  <span class="mb-2 ml-0.5 text-xs text-ash">
                    de <s class="decoration-orange-2/80">R${p.unitFrom}</s>
                  </span>
                </div>
                <div class="mt-3 font-display text-[11px] font-bold uppercase tracking-[0.32em] text-amber">
                  {p.schedule}
                </div>
                <div class="mt-4 flex items-center gap-3 rounded-xl border border-line bg-void/60 px-4 py-2.5">
                  <span class="font-display text-lg font-bold text-bone">
                    R${p.monthly}
                    <span class="ml-0.5 text-xs font-normal text-bone-2">/mês</span>
                  </span>
                  <span class="h-5 w-px bg-line" aria-hidden="true" />
                  <span class="text-sm text-bone-2">{p.monthlyNote}</span>
                </div>
              </>
            ) : (
              <>
                <div class="mt-5 flex items-end gap-1">
                  <span class="text-sm text-bone-2">R$</span>
                  <span
                    class:list={[
                      'font-display text-5xl font-bold leading-none',
                      p.featured ? 'text-gold' : 'text-neon',
                    ]}
                  >
                    {p.monthly}
                  </span>
                  <span class="mb-1 text-sm text-bone-2">/mês</span>
                </div>
                <p class="mt-3 text-sm text-bone-2">{p.tag}</p>
              </>
            )}

            <ul class="mt-5 flex-1 space-y-3">
              {p.features.map((f) => (
                <li class="flex items-center gap-2.5 text-sm text-bone-2">
                  <span
                    class:list={[
                      'grid size-5 shrink-0 place-items-center rounded-full',
                      warm ? 'bg-gold/15 text-gold' : 'bg-neon/15 text-neon',
                    ]}
                  >
                    <Check className="size-3.5" strokeWidth={3} />
                  </span>
                  {f}
                </li>
              ))}
            </ul>

            <Button
              href={p.cta}
              target="_blank"
              rel="noopener"
              variant={warm ? 'gold' : 'primary'}
              class="cta-attract mt-7 w-full"
              data-mag
            >
              Quero assinar
            </Button>
            <span class="glare" aria-hidden="true"></span>
          </div>
        );
      })
    }
  </div>
</section>
