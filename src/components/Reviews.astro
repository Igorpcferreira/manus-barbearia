---
import SectionHead from '@/components/SectionHead.astro';
import { reviews, site } from '@/data/site';
import { Star } from 'lucide-react';
---

<section
  id="avaliacoes"
  class="relative z-10 mx-auto max-w-[1160px] scroll-mt-24 px-4 py-20 sm:px-6 sm:py-28"
>
  <SectionHead kicker="Quem senta na cadeira" center class="mx-auto">
    O que dizem os <span class="text-gradient">clientes</span>
  </SectionHead>

  <div class="reveal mt-8 flex flex-col items-center gap-3" style="--reveal-delay:60ms">
    <div class="flex items-center gap-3">
      <span class="font-display text-4xl font-bold text-bone">{site.rating}</span>
      <span class="flex text-gold" aria-label={`${site.rating} de 5 estrelas`}>
        {Array.from({ length: 5 }).map(() => <Star className="size-5 fill-current" />)}
      </span>
    </div>
    <span
      class="inline-flex items-center gap-2 rounded-full border border-line bg-panel/50 px-4 py-1.5 text-xs font-medium text-bone-2"
    >
      <span
        class="grid size-4 place-items-center rounded-full bg-bone text-[10px] font-bold text-void"
        >G</span
      >
      Avaliações no Google
    </span>
    <p class="max-w-[480px] text-center text-sm text-bone-2">
      Clientes reais, resultado afiado. Veja o que falam de quem confia o visual à
      Manu's.
    </p>
  </div>

  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      reviews.map((r, i) => (
        <article
          data-tilt
          class="reveal relative flex flex-col rounded-2xl border border-line bg-panel/40 p-5 transition-all duration-300 hover:border-neon/40"
          style={`--reveal-delay:${(i % 3) * 70}ms`}
        >
          <span
            class="absolute right-4 top-4 grid size-6 place-items-center rounded-full bg-bone text-xs font-bold text-void"
            aria-hidden="true"
          >
            G
          </span>
          <span class="flex text-gold" aria-label="Avaliação 5 de 5 estrelas">
            {Array.from({ length: 5 }).map(() => (
              <Star className="size-4 fill-current" />
            ))}
          </span>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-bone-2">"{r.quote}"</p>
          <div class="mt-4 flex items-center gap-3 border-t border-line/70 pt-4">
            <span class="grid size-9 shrink-0 place-items-center rounded-full bg-gradient-to-br from-orange to-rust font-display text-sm font-bold text-bone">
              {r.initial}
            </span>
            <div>
              <div class="text-sm font-semibold text-bone">{r.name}</div>
              <div class="text-xs text-ash">{r.date}</div>
            </div>
          </div>
          <span class="glare" aria-hidden="true"></span>
        </article>
      ))
    }
  </div>
</section>
