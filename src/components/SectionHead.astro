---
interface Props {
  kicker: string;
  center?: boolean;
  class?: string;
}
const { kicker, center = false, class: className = "" } = Astro.props;
---

<div class={`reveal ${center ? "text-center" : ""} ${className}`}>
  <span
    class={`inline-flex items-center gap-3 text-xs font-display font-semibold uppercase tracking-[0.22em] text-neon ${center ? "justify-center" : ""}`}
  >
    <span class="h-px w-8 bg-neon/50"></span>
    {kicker}
  </span>
  <h2 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-bold leading-tight">
    <slot />
  </h2>
</div>
